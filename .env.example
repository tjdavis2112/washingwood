# Copy to .env and fill in. Never commit .env.
# League ID: the leagueId=... number in the ESPN league URL
ESPN_LEAGUE_ID=
# ESPN cookies: from a logged-in browser session on fantasy.espn.com (DevTools > Application > Cookies)
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# Postgres DSN, optional. e.g. postgresql://user:pass@host:5432/washingwood
WASHINGWOOD_PG=
