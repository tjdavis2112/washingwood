---
import ChampionBanner from "../components/ChampionBanner";
import Trophy from "../components/Trophy.astro";
import { getLeague } from "../data/site-data";
import Base from "../layouts/Base.astro";

const league = getLeague();
const { champion } = league;
---
<Base title="Home">
  <h1 class="sr-only">{league.leagueName}</h1>
  <ChampionBanner client:visible ownerName={champion.owner.name} teamName={champion.teamName} year={champion.year}>
    <Trophy metal="gold" class="size-full" />
  </ChampionBanner>
</Base>
