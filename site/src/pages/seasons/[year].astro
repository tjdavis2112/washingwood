---
// One page per Season. Results tab: Podium, Last place, final standings, the playoff bracket and
// weekly results. Scoring format tab. Draft tab: the draft board. Rosters, Transactions: Coming soon.
import Bracket from "../../components/Bracket.astro";
import ComingSoon from "../../components/ComingSoon.astro";
import DraftBoard from "../../components/DraftBoard.astro";
import LastPlace from "../../components/LastPlace.astro";
import Podium from "../../components/Podium.astro";
import ScoringFormat from "../../components/ScoringFormat.astro";
import SeasonTabs from "../../components/SeasonTabs.astro";
import Standings from "../../components/Standings.astro";
import WeeklyResults from "../../components/WeeklyResults.astro";
import { getLeague, getSeason } from "../../data/site-data";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return getLeague().seasons.map((s) => ({ params: { year: String(s.year) }, props: { year: s.year } }));
}
const season = getSeason(Astro.props.year);
---
<Base title={`${season.year} Season`}>
  <header class="mb-6">
    <h1 class="text-4xl font-black md:text-6xl">{season.year} Season</h1>
    <p class="mt-2 text-muted">{season.teamCount} teams</p>
  </header>
  <SeasonTabs year={season.year}>
    <div slot="results" class="space-y-8">
      <Podium spots={season.podium} />
      <LastPlace season={season} />
      <Standings rows={season.standings} />
      <Bracket bracket={season.bracket} year={season.year} />
      <WeeklyResults periods={season.weeklyResults} year={season.year} />
    </div>
    <ScoringFormat slot="scoring" format={season.scoringFormat} />
    <ComingSoon slot="rosters" level={2} title="Rosters" blurb="Every Franchise's roster, week by week." />
    <DraftBoard slot="draft" draft={season.draft} />
    <ComingSoon slot="transactions" level={2} title="Transactions" blurb="This Season's trades and waiver pickups." />
  </SeasonTabs>
</Base>
