---
// Placeholder Season page; the real page (Podium, standings, bracket...) arrives with #7-#10.
import ComingSoon from "../../components/ComingSoon.astro";
import { getLeague } from "../../data/site-data";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return getLeague().seasons.map((s) => ({ params: { year: String(s.year) }, props: { season: s } }));
}
const { season } = Astro.props;
---
<Base title={`${season.year} Season`}>
  <ComingSoon title={`${season.year} Season`} blurb={`${season.teamCount} teams. Podium, standings, bracket and weekly results are on the way.`} />
</Base>
