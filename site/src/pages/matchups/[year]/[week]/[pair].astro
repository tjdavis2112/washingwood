---
// A Box score page (#40): one played Matchup with both lineups (GLOSSARY: Box score). Starters in
// slot order with points and ESPN's projection, then the bench and IR; a two-week round shows each
// Week's lineup. Side by side on desktop, stacked on phones. /matchups/<year>/<first week>/<a>-vs-<b>/.
import OwnerLink from "../../../../components/OwnerLink.astro";
import {
  formatPoints,
  formatWeeks,
  getBoxScores,
  getLeague,
  hasBoxScores,
  rivalryPath,
  type BoxScore,
  type BoxScoreEntry,
  type BoxScoreSide,
} from "../../../../data/site-data";
import Base from "../../../../layouts/Base.astro";

export function getStaticPaths() {
  return getLeague()
    .seasons.filter((s) => hasBoxScores(s.year))
    .flatMap((s) =>
      getBoxScores(s.year).map((m) => ({
        params: {
          year: String(s.year),
          week: String(m.weeks[0]),
          pair: [m.home.owner.slug, m.away.owner.slug].sort().join("-vs-"),
        },
        props: { year: s.year, matchup: m },
      })),
    );
}
const { year, matchup } = Astro.props as { year: number; matchup: BoxScore };
const KIND = { regular: "Regular season", playoff: "Playoffs", thirdPlace: "Third-place game", consolation: "Consolation" } as const;
const sides: { key: "home" | "away"; side: BoxScoreSide }[] = [
  { key: "home", side: matchup.home },
  { key: "away", side: matchup.away },
];
const pts = (n: number | null) => (n === null ? "—" : formatPoints(n));
const detail = (e: BoxScoreEntry) => `${e.position}${e.nflTeam ? ` · ${e.nflTeam}` : ""}`;
const title = `${matchup.home.owner.name} vs ${matchup.away.owner.name}`;
---
<Base title={`${title} · ${year} ${formatWeeks(matchup.weeks)}`}>
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">
      <a href={`/seasons/${year}/`} class="hover:text-brand">{year}</a> · {formatWeeks(matchup.weeks)} · {KIND[matchup.kind]}
    </p>
    <h1 class="mt-2 text-3xl font-black md:text-5xl">Box score</h1>
    <p class="mt-2 text-sm"><a href={rivalryPath(matchup.home.owner.slug, matchup.away.owner.slug)} class="text-muted underline decoration-line underline-offset-4 hover:text-brand">{title}: every meeting →</a></p>
  </header>

  <!-- Scoreboard -->
  <div data-testid="scoreboard" class="grid grid-cols-2 gap-3">
    {sides.map(({ key, side }) => {
      const won = matchup.winner === key;
      return (
        <div data-testid="scoreboard-side" class:list={["rounded-2xl border border-line p-4", won ? "bg-brand/10" : "bg-panel/60"]}>
          <OwnerLink owner={side.owner} class:list={["block truncate text-lg", won ? "font-bold" : "font-semibold text-paper/80"]} />
          <span class="block truncate text-xs text-muted">{side.teamName}</span>
          <span class:list={["mt-2 block text-3xl font-black tabular-nums", !won && "text-paper/70"]}>{formatPoints(side.score)}</span>
          <span class="block text-xs text-muted">Projected {formatPoints(side.projected)}</span>
          {won && <span class="mt-1 block text-[0.65rem] font-semibold uppercase tracking-wider text-brand">Winner</span>}
          {side.adjustment !== 0 && (
            <span data-testid="adjustment" class="mt-2 block text-xs text-muted">
              Manual adjustment {side.adjustment > 0 ? "+" : ""}{formatPoints(side.adjustment)} (counts toward points for, not this score)
            </span>
          )}
        </div>
      );
    })}
  </div>
  {matchup.isTie && <p class="mt-3 text-center text-sm font-semibold uppercase tracking-widest text-muted">Tie</p>}

  <!-- Lineups -->
  {matchup.weeks.map((week, wi) => (
    <section aria-label={formatWeeks([week])} class="mt-10">
      {matchup.weeks.length > 1 && <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-muted">{formatWeeks([week])}</h2>}
      <div class="grid gap-6 md:grid-cols-2">
        {sides.map(({ side }) => {
          const w = side.weeks[wi];
          const total = w.starters.reduce((n, e) => n + (e.points ?? 0), 0);
          return (
            <div data-testid="lineup" data-owner={side.owner.slug} data-week={week} class="overflow-hidden rounded-2xl border border-line">
              <table aria-label={`${side.owner.name}, ${formatWeeks([week])}`} class="w-full border-collapse text-sm">
                <thead class="bg-panel text-left text-xs uppercase tracking-wider text-muted">
                  <tr>
                    <th scope="col" class="w-14 px-3 py-2">Slot</th>
                    <th scope="col" class="px-2 py-2">{side.owner.name}</th>
                    <th scope="col" class="px-2 py-2 text-right">Proj</th>
                    <th scope="col" class="px-3 py-2 text-right">Pts</th>
                  </tr>
                </thead>
                <tbody>
                  {w.starters.map((e) => (
                    <tr data-testid="starter" class="border-t border-line">
                      <td class="px-3 py-1.5 text-xs font-semibold text-muted">{e.slot}</td>
                      <td class="px-2 py-1.5"><span class="block font-semibold leading-tight">{e.name}</span><span class="block text-xs text-muted">{detail(e)}</span></td>
                      <td class="px-2 py-1.5 text-right tabular-nums text-muted">{pts(e.projected)}</td>
                      <td class="px-3 py-1.5 text-right font-semibold tabular-nums">{pts(e.points)}</td>
                    </tr>
                  ))}
                  {w.emptySlots.map((slot) => (
                    <tr data-testid="empty-slot" class="border-t border-line text-muted">
                      <td class="px-3 py-1.5 text-xs font-semibold">{slot}</td>
                      <td class="px-2 py-1.5 italic" colspan="3">Empty</td>
                    </tr>
                  ))}
                  <tr class="border-t border-line bg-panel/60 font-bold">
                    <td class="px-3 py-2 text-xs uppercase tracking-wider text-muted" colspan="3">Total</td>
                    <td class="px-3 py-2 text-right tabular-nums">{formatPoints(total)}</td>
                  </tr>
                  {w.bench.map((e, i) => (
                    <tr data-testid="bench" class:list={["text-muted", i === 0 ? "border-t-2 border-line" : "border-t border-line"]}>
                      <td class="px-3 py-1.5 text-xs">{e.slot}</td>
                      <td class="px-2 py-1.5"><span class="block leading-tight">{e.name}</span><span class="block text-xs">{detail(e)}</span></td>
                      <td class="px-2 py-1.5 text-right tabular-nums">{pts(e.projected)}</td>
                      <td class="px-3 py-1.5 text-right tabular-nums">{pts(e.points)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          );
        })}
      </div>
    </section>
  ))}
</Base>
