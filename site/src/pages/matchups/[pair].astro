---
// A Rivalry page (#39): two Owners' head-to-head history. Records follow the Owner page's head-to-head
// rules (GLOSSARY: Rivalry); every game is listed, newest first, with the Third-place game and
// consolation games marked "not in record". One page per pair that has played, slugs in alphabetical
// order (/matchups/<a>-vs-<b>/).
import OwnerLink from "../../components/OwnerLink.astro";
import { boxScorePath, formatPoints, formatWeeks, getMatchups, getRivalry, hasBoxScores, type RivalryGame, type WinLossTie } from "../../data/site-data";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  const pairs = new Set(
    getMatchups().rivalryGrid.records.map((r) => [r.owner, r.opponent].sort().join("-vs-")),
  );
  return [...pairs].map((pair) => ({ params: { pair } }));
}
const rivalry = getRivalry(Astro.params.pair!);
const [a, b] = rivalry.sides;
const KIND = { regular: "Regular season", playoff: "Playoffs", thirdPlace: "Third-place game", consolation: "Consolation" } as const;
const rec = (r: WinLossTie) => `${r.wins}-${r.losses}-${r.ties}`;
const gameLine = (g: RivalryGame) => `${g.year} · ${formatWeeks(g.weeks)}`;
const short = (name: string) => {
  const [first, ...rest] = name.split(" ");
  return rest.length ? `${first} ${rest[rest.length - 1][0]}.` : first;
};
---
<Base title={`${a.owner.name} vs ${b.owner.name}`}>
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-muted"><a href="/matchups/" class="hover:text-brand">Matchups</a> · Rivalry</p>
    <h1 class="mt-2 text-3xl font-black md:text-5xl">{a.owner.name} <span class="text-muted">vs</span> {b.owner.name}</h1>
    <p class="mt-2 text-muted"><span data-testid="meetings">{rivalry.meetings}</span> {rivalry.meetings === 1 ? "meeting" : "meetings"} in the record</p>
  </header>

  <div class="grid gap-4 md:grid-cols-2">
    {rivalry.sides.map((s, i) => (
      <section aria-label={s.owner.name} data-testid="rivalry-side" class="rounded-2xl border border-line bg-panel/60 p-5">
        <OwnerLink owner={s.owner} class="text-xl font-bold" />
        <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
          <div><dt class="text-xs uppercase tracking-wider text-muted">Regular season</dt><dd class="text-lg font-bold tabular-nums">{rec(s.regularSeason)}</dd></div>
          <div><dt class="text-xs uppercase tracking-wider text-muted">Playoffs</dt><dd class="text-lg font-bold tabular-nums">{rec(s.playoffs)}</dd></div>
        </dl>
        <p class="mt-3 border-t border-line pt-3 text-sm" data-testid="biggest-win">
          <span class="text-xs uppercase tracking-wider text-muted">Biggest win</span><br />
          {s.biggestWin ? (
            <span>
              {gameLine(s.biggestWin)}: {formatPoints(s.biggestWin.teams[i].score)}–{formatPoints(s.biggestWin.teams[1 - i].score)}
              <span class="text-muted"> (by {formatPoints(s.biggestWin.margin)})</span>
            </span>
          ) : (
            <span class="text-muted">None yet</span>
          )}
        </p>
      </section>
    ))}
  </div>

  <section aria-labelledby="games-heading" class="mt-10">
    <h2 id="games-heading" class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">Every game</h2>
    <div class="mt-4 overflow-x-auto rounded-2xl border border-line">
      <table aria-labelledby="games-heading" class="w-full border-collapse text-sm">
        <thead class="bg-panel text-left text-xs uppercase tracking-wider text-muted">
          <tr>
            <th scope="col" class="sticky left-0 bg-panel px-3 py-3">Season</th>
            <th scope="col" class="px-3 py-3">Game</th>
            <th scope="col" class="px-3 py-3 text-right" title={a.owner.name}>{short(a.owner.name)}</th>
            <th scope="col" class="px-3 py-3 text-right" title={b.owner.name}>{short(b.owner.name)}</th>
          </tr>
        </thead>
        <tbody>
          {rivalry.games.map((g) => (
            <tr data-testid="rivalry-game" data-in-record={String(g.inRecord)} class:list={["border-t border-line odd:bg-ink even:bg-panel/40", !g.inRecord && "text-muted"]}>
              <td class="sticky left-0 bg-inherit px-3 py-2.5 whitespace-nowrap">
                <a href={`/seasons/${g.year}/`} class="font-semibold transition-colors hover:text-brand">{g.year}</a>
                <span class="block text-xs text-muted">{formatWeeks(g.weeks)}</span>
                {hasBoxScores(g.year) && <a href={boxScorePath(g.year, g.weeks[0], a.owner.slug, b.owner.slug)} data-testid="box-score-link" class="block text-xs font-semibold text-muted underline decoration-line underline-offset-4 hover:text-brand">Box score</a>}
              </td>
              <td class="px-3 py-2.5">
                {KIND[g.kind]}
                {!g.inRecord && <span class="ml-1 rounded-full border border-line px-2 py-0.5 text-[0.65rem]">not in record</span>}
                {g.isTie && <span class="ml-1 text-xs">tie</span>}
              </td>
              {g.teams.map((t, i) => (
                <td class:list={["px-3 py-2.5 text-right tabular-nums", g.winner === i && "font-bold text-paper"]}>
                  {formatPoints(t.score)}
                  <span class="block text-xs font-normal text-muted break-words">{t.teamName}</span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
