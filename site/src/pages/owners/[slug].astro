---
// One page per Owner, rendered from owners/<slug>.json. Career tab: trophy case, career summary,
// the season-by-season table and head-to-head.
// Rosters, Draft, Trades: Coming soon.
import CareerSummary from "../../components/CareerSummary.astro";
import ComingSoon from "../../components/ComingSoon.astro";
import HeadToHead from "../../components/HeadToHead.astro";
import OwnerSeasons from "../../components/OwnerSeasons.astro";
import OwnerTrophyCase from "../../components/OwnerTrophyCase.astro";
import Tabs from "../../components/Tabs.astro";
import { formatSpan, getOwner, getOwnerIndex } from "../../data/site-data";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return getOwnerIndex().map((e) => ({ params: { slug: e.owner.slug } }));
}
const owner = getOwner(Astro.params.slug!);
const TABS = [
  { id: "career", label: "Career" },
  { id: "rosters", label: "Rosters" },
  { id: "draft", label: "Draft" },
  { id: "trades", label: "Trades" },
];
---
<Base title={owner.owner.name}>
  <header class="mb-6">
    <h1 class="text-4xl font-black md:text-6xl">{owner.owner.name}</h1>
    <p class="mt-2 text-muted">
      {owner.currentTeamName} · {formatSpan(owner.firstSeason, owner.lastSeason)}
      {owner.isFormer && <span class="ml-2 rounded-full border border-line px-2 py-0.5 text-[0.7rem] font-semibold uppercase tracking-widest">Former Owner</span>}
    </p>
  </header>
  <Tabs label={`${owner.owner.name} sections`} tabs={TABS}>
    <div slot="career" class="space-y-8">
      <OwnerTrophyCase trophies={owner.trophies} />
      <CareerSummary career={owner.career} seasonCount={owner.seasons.length} />
      <OwnerSeasons rows={owner.seasons} />
      <HeadToHead rows={owner.headToHead} />
    </div>
    <ComingSoon slot="rosters" level={2} title="Rosters" blurb="This Owner's roster every Season." />
    <ComingSoon slot="draft" level={2} title="Draft" blurb="Every pick this Owner has made, graded." />
    <ComingSoon slot="trades" level={2} title="Trades" blurb="Every trade this Owner has made, and who won it." />
  </Tabs>
</Base>
