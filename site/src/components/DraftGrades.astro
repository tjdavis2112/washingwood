---
// A Season's Draft grades (#28): one row per Franchise, by rank (ties share a rank), with the total
// Points over expected and the best and worst Pick, then the Season's Replacement level. On phones the
// table scrolls sideways inside its own box, with the Owner column pinned.
import OwnerLink from "./OwnerLink.astro";
import { formatValue } from "../data/positions";
import { formatPick, type DraftGrade, type GradedPick, type ReplacementLevel } from "../data/site-data";

interface Props { grades: DraftGrade[]; replacement: ReplacementLevel[] }
const { grades, replacement } = Astro.props;
const valueClass = (v: number) => (v > 0 ? "text-[color:var(--color-value-steal)]" : v < 0 ? "text-[color:var(--color-value-bust)]" : "text-muted");
const pickText = (p: GradedPick) => `${formatPick(p)} ${p.player.name}`;
---
<section aria-labelledby="draft-grades-heading" data-testid="draft-grades">
  <div class="flex items-baseline justify-between gap-4">
    <h2 id="draft-grades-heading" class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">Draft grades</h2>
    <p aria-hidden="true" class="text-xs text-muted md:hidden">Swipe for more →</p>
  </div>
  <p class="mt-2 text-xs text-muted">Total Points over expected: for each pick, the points it scored above a replacement starter at its position, minus what a pick in that round usually returns.</p>
  <div data-testid="draft-grades-scroll" class="mt-4 overflow-x-auto rounded-2xl border border-line">
    <table aria-labelledby="draft-grades-heading" class="w-full min-w-[44rem] border-collapse text-sm">
      <thead class="bg-panel text-left text-xs uppercase tracking-wider text-muted">
        <tr>
          <th scope="col" class="px-3 py-3 text-right">#</th>
          <th scope="col" class="sticky left-0 bg-panel px-3 py-3">Owner</th>
          <th scope="col" class="px-3 py-3">Team</th>
          <th scope="col" class="px-3 py-3 text-right">Total</th>
          <th scope="col" class="px-3 py-3">Best pick</th>
          <th scope="col" class="px-3 py-3">Worst pick</th>
        </tr>
      </thead>
      <tbody>
        {grades.map((g) => (
          <tr data-testid="draft-grade" class="border-t border-line odd:bg-ink even:bg-panel/40">
            <td class="px-3 py-2.5 text-right font-bold tabular-nums">{g.rank}</td>
            <td class="sticky left-0 bg-inherit px-3 py-2.5 font-semibold whitespace-nowrap"><OwnerLink owner={g.owner} /></td>
            <td class="px-3 py-2.5 whitespace-nowrap text-muted">{g.teamName}</td>
            <td class:list={["px-3 py-2.5 text-right font-bold tabular-nums", valueClass(g.total)]}>{formatValue(g.total)}</td>
            <td class="px-3 py-2.5 whitespace-nowrap">{pickText(g.best)} <span class:list={["font-semibold tabular-nums", valueClass(g.best.pointsOverExpected)]}>{formatValue(g.best.pointsOverExpected)}</span></td>
            <td class="px-3 py-2.5 whitespace-nowrap">{pickText(g.worst)} <span class:list={["font-semibold tabular-nums", valueClass(g.worst.pointsOverExpected)]}>{formatValue(g.worst.pointsOverExpected)}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p data-testid="replacement-level" class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">
    <span>Replacement level this Season:</span>
    {replacement.map((r) => (
      <span class="whitespace-nowrap"><span class="font-semibold text-paper">{r.position}{r.finish}</span> {r.points.toFixed(1)} pts</span>
    ))}
  </p>
</section>
