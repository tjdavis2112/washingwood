---
// The shared styled placeholder for sections that aren't built yet.
interface Props { title: string; blurb?: string }
const { title, blurb } = Astro.props;
---
<section class="flex min-h-[50dvh] flex-col items-center justify-center rounded-3xl border border-dashed border-line px-6 py-16 text-center">
  <h1 class="text-4xl font-black md:text-6xl">{title}</h1>
  <p class="mt-4 rounded-full bg-brand px-4 py-1 text-sm font-semibold uppercase tracking-[0.2em]">Coming soon</p>
  {blurb && <p class="mt-6 max-w-md text-muted">{blurb}</p>}
</section>
