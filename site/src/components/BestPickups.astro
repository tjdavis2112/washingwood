---
// Best pickups (#63): the top 10 Pickups of all time, as a table like the Matchups leaderboards. It scrolls
// inside its own box on a phone (first column sticky), and each row carries its Scoring format badge. On a
// Season page (#64, `season` set) it lists that Season's top 10: Week instead of Season, no Format column.
import type { Pickup } from "../data/site-data";
import { formatPoints } from "../data/site-data";
import OwnerLink from "./OwnerLink.astro";

interface Props { pickups: Pickup[]; season?: number }
const { pickups, season } = Astro.props;
const allTime = season === undefined;
const VIA = { waiver: "via waivers", free_agent: "free agent" } as const;
---
<section aria-labelledby="best-pickups-heading" data-testid="best-pickups" class="mb-10">
  <h2 id="best-pickups-heading" class="text-2xl font-black">Best pickups</h2>
  <p class="mt-1 mb-4 text-xs text-muted">
    Waiver claims and free-agent adds, ranked by the points the Player scored as a starter for that team until
    they left it.{allTime && " Scoring formats differ between Seasons, so check each row's format."}
  </p>
  {pickups.length === 0 ? <p class="text-muted">{allTime ? "No pickups yet." : `No pickups in ${season}.`}</p> : (
    <div class="overflow-x-auto rounded-2xl border border-line">
      <table aria-label={allTime ? "Best pickups" : `Best pickups of ${season}`} class="w-full min-w-[40rem] border-collapse text-sm">
        <thead class="bg-panel text-left text-xs uppercase tracking-wider text-muted">
          <tr>
            <th scope="col" class="px-3 py-3 text-right">#</th>
            <th scope="col" class="sticky left-0 bg-panel px-3 py-3">{allTime ? "Season" : "Week"}</th>
            <th scope="col" class="px-3 py-3">Player</th>
            <th scope="col" class="px-3 py-3">Owner</th>
            <th scope="col" class="px-3 py-3 text-right">Points</th>
            {allTime && <th scope="col" class="px-3 py-3">Format</th>}
          </tr>
        </thead>
        <tbody>
          {pickups.map((p, i) => (
            <tr data-testid="pickup-row" class="border-t border-line odd:bg-ink even:bg-panel/40">
              <td class="px-3 py-2.5 text-right font-bold tabular-nums">{i + 1}</td>
              <td class="sticky left-0 bg-inherit px-3 py-2.5 whitespace-nowrap">
                {allTime ? <>
                  <a href={`/seasons/${p.year}/`} class="font-semibold transition-colors hover:text-brand">{p.year}</a>
                  <span class="block text-xs text-muted">Week {p.week}</span>
                </> : <span class="font-semibold">Week {p.week}</span>}
              </td>
              <td class="px-3 py-2.5 whitespace-nowrap">
                <span class="font-semibold">{p.name}</span>
                <span class="block text-xs text-muted">{p.position}{p.nflTeam && ` · ${p.nflTeam}`} · <span data-testid="pickup-via">{VIA[p.via]}</span></span>
              </td>
              <td class="px-3 py-2.5 whitespace-nowrap"><OwnerLink owner={p.owner} /><span class="block text-xs text-muted">{p.teamName}</span></td>
              <td class="px-3 py-2.5 text-right whitespace-nowrap tabular-nums">
                <span class="font-bold">{formatPoints(p.points)}</span>
                <span class="block text-xs text-muted">{p.weeksStarted} {p.weeksStarted === 1 ? "start" : "starts"}</span>
              </td>
              {allTime && <td class="px-3 py-2.5"><span data-testid="format-badge" class="whitespace-nowrap rounded-full border border-line px-2 py-0.5 text-[0.7rem] text-muted">{p.scoringFormat}</span></td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</section>
