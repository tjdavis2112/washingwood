---
// Accessible tabs (WAI-ARIA tabs pattern), shared by the Season and Owner pages. An inline script
// wires them as soon as the HTML is parsed: click or arrow keys switch tabs, and the URL hash
// (#scoring) is kept in sync so a tab can be linked. A hash naming an element inside a panel
// (#season-most-points-for) opens that panel's tab. Each panel's content is the slot named by its tab id.
interface Props { label: string; tabs: { id: string; label: string }[] }
const { label, tabs } = Astro.props;
const panels = await Promise.all(tabs.map((t) => Astro.slots.render(t.id)));
---
<div data-tabs>
  <div class="-mx-4 overflow-x-auto px-4 md:mx-0 md:px-0">
    <div role="tablist" aria-label={label} class="flex w-max gap-1 border-b border-line md:w-auto">
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-tab={t.id}
          class="-mb-px whitespace-nowrap border-b-2 border-transparent px-4 py-2.5 text-sm font-semibold text-muted transition-colors hover:text-paper aria-selected:border-brand aria-selected:text-paper"
        >{t.label}</button>
      ))}
    </div>
  </div>
  {tabs.map((t, i) => (
    <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} tabindex="0" hidden={i !== 0} class="pt-8 focus:outline-none">
      <Fragment set:html={panels[i]} />
    </div>
  ))}
</div>

<script is:inline>
  (() => {
    const root = document.currentScript.previousElementSibling;
    const tabs = [...root.querySelectorAll("[role=tab]")];
    const select = (tab, { focus = false, updateHash = true } = {}) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
      }
      if (focus) tab.focus();
      if (updateHash) history.replaceState(null, "", `#${tab.dataset.tab}`);
    };
    for (const t of tabs) t.addEventListener("click", () => select(t));
    root.querySelector("[role=tablist]").addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement);
      if (i < 0) return;
      const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select(tabs[(next + tabs.length) % tabs.length], { focus: true });
    });
    // Open the tab named in the URL (e.g. #scoring), or the tab holding the element it names
    // (e.g. #season-most-points-for, a record inside the Season tab)
    const target = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const linked =
      tabs.find((t) => `#${t.dataset.tab}` === location.hash) ??
      (target && tabs.find((t) => document.getElementById(t.getAttribute("aria-controls")).contains(target)));
    if (linked) {
      select(linked, { updateHash: false });
      // On a phone the tab strip scrolls sideways: bring a linked tab past the right edge into view
      const bar = root.firstElementChild.getBoundingClientRect();
      const edge = linked.getBoundingClientRect().right - bar.right;
      if (edge > 0) root.firstElementChild.scrollLeft += Math.ceil(edge) + 16;
    }
  })();
</script>
