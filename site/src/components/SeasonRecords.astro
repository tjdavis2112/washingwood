---
// Record Book Season records (#51, #52, #54): top-10 Franchise-Seasons per record, regular season only, picked
// from a chip row (RecordPicker). Points rank per game, with the total beside it, so 13-game and 14-game
// Seasons compare fairly (GLOSSARY: Points per game); Bench points are the regular-season total. Every
// row shows its Scoring format. The Luck lists show actual and Expected wins, with the formula below.
import LuckExplainer from "./LuckExplainer.astro";
import OwnerLink from "./OwnerLink.astro";
import RecordPicker from "./RecordPicker.astro";
import { formatLuck, formatPct, formatPoints, formatRecord, type RecordBookDoc, type SeasonRecordRow } from "../data/site-data";

interface Props { records: RecordBookDoc["season"] }
const { records } = Astro.props;

// total: a second column beside the stat (its label defaults to Total)
type Stat = { label: string; value: (r: SeasonRecordRow) => string; total?: (r: SeasonRecordRow) => string; totalLabel?: string };
const WIN_PCT: Stat = { label: "Win %", value: (r) => formatPct(r.winPct) };
const PPG: Stat = { label: "Per game", value: (r) => formatPoints(r.pointsPerGame), total: (r) => formatPoints(r.pointsFor) };
const PAPG: Stat = { label: "Per game", value: (r) => formatPoints(r.pointsAgainstPerGame), total: (r) => formatPoints(r.pointsAgainst) };
const BENCH: Stat = { label: "Bench points", value: (r) => formatPoints(r.benchPoints ?? 0) };
const LUCK: Stat = { label: "Luck", value: (r) => formatLuck(r.luck ?? 0), total: (r) => (r.expectedWins ?? 0).toFixed(2), totalLabel: "Expected wins" };
const LISTS = [
  { id: "season-best-win-pct", chip: "Best win %", title: "Best win %", rows: records.bestWinPct, stat: WIN_PCT },
  { id: "season-worst-win-pct", chip: "Worst win %", title: "Worst win %", rows: records.worstWinPct, stat: WIN_PCT },
  { id: "season-most-points-for", chip: "Most points", title: "Most points per game", rows: records.mostPointsFor, stat: PPG },
  { id: "season-fewest-points-for", chip: "Fewest points", title: "Fewest points per game", rows: records.fewestPointsFor, stat: PPG },
  { id: "season-most-points-against", chip: "Most points against", title: "Most points against per game", rows: records.mostPointsAgainst, stat: PAPG },
  { id: "season-most-bench-points", chip: "Most bench points", title: "Most bench points", rows: records.mostBenchPoints, stat: BENCH },
  { id: "season-luckiest", chip: "Luckiest", title: "Luckiest Seasons", rows: records.luckiest, stat: LUCK },
  { id: "season-unluckiest", chip: "Unluckiest", title: "Unluckiest Seasons", rows: records.unluckiest, stat: LUCK },
];
---
<p class="mb-4 text-xs text-muted">
  Top 10 Seasons, regular season only. Win % counts a tie as half a win. Points rank per game, so 13-game
  and 14-game Seasons compare fairly. Bench points are the Season total of points left on the bench (IR
  doesn't count).
</p>
<RecordPicker label="Season records" testid="season-record" records={LISTS}>
  {LISTS.map((l) => (
    <div slot={l.id}>
      {l.rows.length === 0 ? (
        <p class="text-sm text-muted">None yet.</p>
      ) : (
        <div class="overflow-x-auto rounded-2xl border border-line">
          <table aria-label={l.title} class="w-full min-w-[40rem] border-collapse text-sm">
            <thead class="bg-panel text-left text-xs uppercase tracking-wider text-muted">
              <tr>
                <th scope="col" class="px-3 py-3 text-right">#</th>
                <th scope="col" class="sticky left-0 bg-panel px-3 py-3">Season</th>
                <th scope="col" class="px-3 py-3">Owner</th>
                <th scope="col" class="px-3 py-3 text-right text-paper">{l.stat.label}</th>
                {l.stat.total && <th scope="col" class="px-3 py-3 text-right">{l.stat.totalLabel ?? "Total"}</th>}
                <th scope="col" class="px-3 py-3 text-right">Record</th>
                <th scope="col" class="px-3 py-3">Format</th>
              </tr>
            </thead>
            <tbody>
              {l.rows.map((r, n) => (
                <tr data-testid="season-record-row" data-year={r.year} class="border-t border-line odd:bg-ink even:bg-panel/40">
                  <td class="px-3 py-2.5 text-right font-bold tabular-nums">{n + 1}</td>
                  <th scope="row" class="sticky left-0 bg-inherit px-3 py-2.5 text-left font-semibold tabular-nums">
                    <a href={`/seasons/${r.year}/`} class="hover:text-brand">{r.year}</a>
                  </th>
                  <td class="px-3 py-2.5 whitespace-nowrap">
                    <OwnerLink owner={r.owner} class="font-semibold" />
                    <span class="block text-xs text-muted">{r.teamName}</span>
                  </td>
                  <td data-testid="record-value" class="px-3 py-2.5 text-right font-bold tabular-nums">{l.stat.value(r)}</td>
                  {l.stat.total && <td data-testid="record-total" class="px-3 py-2.5 text-right tabular-nums text-muted">{l.stat.total(r)}</td>}
                  <td class="px-3 py-2.5 text-right tabular-nums">{formatRecord(r.record)}</td>
                  <td class="px-3 py-2.5"><span data-testid="format-badge" class="whitespace-nowrap rounded-full border border-line px-2 py-0.5 text-[0.7rem] text-muted">{r.scoringFormat}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {l.stat === LUCK && <LuckExplainer />}
    </div>
  ))}
</RecordPicker>
