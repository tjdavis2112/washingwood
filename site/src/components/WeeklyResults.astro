---
// Weekly results: one column per Matchup period with every Matchup in it. On phones the columns
// run left to right and scroll sideways inside this box (snapping a Week at a time); from tablet
// width up they wrap into a grid that uses the full width. The page itself never scrolls sideways.
// The box is `relative` so the screen-reader-only "Winner" labels (absolutely positioned) are
// anchored and clipped inside it; without that they sit thousands of pixels right and widen the page.
import { formatPoints, formatWeeks, type WeeklyPeriod, type WeeklySide } from "../data/site-data";

interface Props { periods: WeeklyPeriod[] }
const { periods } = Astro.props;
---
<section aria-labelledby="weekly-heading">
  <div class="flex items-baseline justify-between gap-4">
    <h2 id="weekly-heading" class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">Weekly results</h2>
    <p aria-hidden="true" class="text-xs text-muted md:hidden">Swipe for more →</p>
  </div>
  <div
    data-testid="weekly-grid"
    class="relative -mx-4 mt-4 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-2 md:mx-0 md:grid md:snap-none md:grid-cols-[repeat(auto-fill,minmax(15rem,1fr))] md:overflow-visible md:px-0"
  >
    {periods.map((p) => {
      const id = `week-${p.matchupPeriod}`;
      return (
        <div role="group" aria-labelledby={id} class="w-[17rem] shrink-0 snap-start md:w-auto">
          <h3 id={id} class="mb-2 text-sm font-bold text-paper">{formatWeeks(p.weeks)}</h3>
          <ul class="space-y-2">
            {p.matchups.map((g) => {
              const sides: { side: WeeklySide; won: boolean }[] = [{ side: g.home, won: g.winner === "home" }];
              if (g.away) sides.push({ side: g.away, won: g.winner === "away" });
              return (
                <li class="overflow-hidden rounded-xl border border-line bg-panel">
                  {sides.map(({ side, won }, i) => (
                    <div data-testid="weekly-side" class:list={["flex items-center gap-2 px-3 py-1.5", { "border-t border-line": i > 0, "bg-brand/10": won }]}>
                      <span class="min-w-0 flex-1">
                        <span class:list={["block truncate text-sm", won ? "font-bold text-paper" : "font-medium text-muted"]}>{side.owner.name}</span>
                        <span class="block truncate text-[0.7rem] text-muted">{side.teamName}</span>
                      </span>
                      {won && <span class="sr-only">Winner</span>}
                      {side.score !== null && (
                        <span class:list={["shrink-0 text-sm tabular-nums", won || g.isTie ? "font-bold text-paper" : "text-muted"]}>{formatPoints(side.score)}</span>
                      )}
                    </div>
                  ))}
                  {(g.isTie || g.isBye) && (
                    <div class="border-t border-dashed border-line px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-widest text-muted">
                      {g.isTie ? "Tie" : "Bye"}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </div>
</section>
