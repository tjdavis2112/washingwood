---
// An Owner's Draft tab (#26). A "First-round picks" strip (their round-1 Player every Season), then
// their Picks Season by Season, newest first, each Season linking to its draft board. Both wrap into
// a grid, so phones never scroll sideways and desktop doesn't stretch one long list.
import { pickStyle } from "../data/positions";
import { formatPick, type DraftPlayer, type OwnerDraftSeason } from "../data/site-data";

interface Props { seasons: OwnerDraftSeason[] }
const { seasons } = Astro.props;
const detail = (p: DraftPlayer) => `${p.position}${p.nflTeam ? ` · ${p.nflTeam}` : ""}`;
---
<div class="space-y-10">
  <section aria-labelledby="first-round-heading">
    <h2 id="first-round-heading" class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">First-round picks</h2>
    <ol data-testid="first-round-strip" class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
      {seasons.map((s) => {
        const p = s.picks[0];
        return (
          <li data-testid="first-round-pick" data-year={s.year} class="rounded-xl border-l-4 border-line bg-panel/40 px-3 py-2" style={pickStyle(p.player)}>
            <div class="flex items-baseline justify-between gap-2 text-xs tabular-nums text-muted">
              <span class="font-bold text-paper">{s.year}</span><span>{formatPick(p)}</span>
            </div>
            {p.player ? (
              <>
                <div class="truncate font-semibold leading-tight">{p.player.name}</div>
                <div class="text-xs text-paper/80">{detail(p.player)}</div>
              </>
            ) : (
              <div class="text-sm italic text-muted">Not recorded</div>
            )}
          </li>
        );
      })}
    </ol>
  </section>

  <section aria-labelledby="owner-picks-heading">
    <h2 id="owner-picks-heading" class="text-xs font-semibold uppercase tracking-[0.3em] text-muted">Picks by Season</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {seasons.map((s) => (
        <div role="group" aria-labelledby={`owner-draft-${s.year}`} data-testid="owner-draft-season" data-year={s.year} class="rounded-2xl border border-line p-3">
          <h3 id={`owner-draft-${s.year}`} class="flex flex-wrap items-baseline justify-between gap-x-3 px-1 pb-2">
            <a href={`/seasons/${s.year}/#draft`} class="text-lg font-black transition-colors hover:text-brand">{s.year}</a>
            <span class="text-xs text-muted">{s.teamName} · Slot {s.slot}</span>
          </h3>
          <ol class="space-y-1.5">
            {s.picks.map((p) => (
              <li data-testid="owner-pick" data-overall={p.overall} class:list={["flex items-center gap-3 rounded-lg border-l-4 px-3 py-1.5", p.player ? "" : "border-line bg-panel/40"]} style={pickStyle(p.player)}>
                <span class="w-10 shrink-0 text-xs tabular-nums text-muted">{formatPick(p)}</span>
                <span class="min-w-0 flex-1">
                  {p.player ? (
                    <>
                      <span class="block truncate font-semibold">{p.player.name}</span>
                      <span class="block text-xs text-paper/80">{detail(p.player)}</span>
                    </>
                  ) : (
                    <span class="block text-sm italic text-muted">Not recorded</span>
                  )}
                </span>
                <span class="shrink-0 text-xs tabular-nums text-muted">#{p.overall}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>
</div>
