---
// The Season page's tabs: Results, Scoring format, and Rosters / Draft / Transactions.
import Tabs from "./Tabs.astro";

interface Props { year: number }
const { year } = Astro.props;
const TABS = [
  { id: "results", label: "Results" },
  { id: "scoring", label: "Scoring format" },
  { id: "rosters", label: "Rosters" },
  { id: "draft", label: "Draft" },
  { id: "transactions", label: "Transactions" },
];
---
<Tabs label={`${year} Season sections`} tabs={TABS}>
  <slot name="results" slot="results" />
  <slot name="scoring" slot="scoring" />
  <slot name="rosters" slot="rosters" />
  <slot name="draft" slot="draft" />
  <slot name="transactions" slot="transactions" />
</Tabs>
