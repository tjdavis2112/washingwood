---
// One trade as a card (#62): Season and Week, both sides with the Players each received (position, NFL
// team, Value added with raw starter points beside it, Weeks started) and the side total, "won by N" (in
// Value added), and the winning side highlighted.
// Reused by the Season and Owner Transactions tabs, which filter transactions.json. A Fleeced trade (#66)
// gets a gold border and a "Fleeced" label wherever it appears, plus a slow shine on hover: desktop widths
// only, and never under prefers-reduced-motion. No tilt or flip (saved for the Hall of Fame).
import type { Trade } from "../data/site-data";
import { formatPoints, formatSigned } from "../data/site-data";
import OwnerLink from "./OwnerLink.astro";

interface Props { trade: Trade }
const { trade } = Astro.props;
const [first] = trade.sides;
const tied = first.outcome === "tied";
---
<article
  data-testid="trade-card"
  data-year={trade.year}
  data-week={trade.week}
  data-fleeced={trade.fleeced ? "true" : undefined}
  class:list={["rounded-3xl bg-panel/40 p-4 md:p-5", trade.fleeced ? "fleeced relative overflow-hidden border-2 border-gold" : "border border-line"]}
>
  {trade.fleeced && <span data-testid="fleeced-shine" class="fleeced-shine" aria-hidden="true"></span>}
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted">
      {trade.fleeced && <span data-testid="fleeced-label" class="mr-2 rounded-full border border-gold px-2 py-0.5 text-[0.65rem] tracking-[0.2em] text-gold">Fleeced</span>}
      <a href={`/seasons/${trade.year}/`} class="transition-colors hover:text-brand">{trade.year}</a> · Week {trade.week}
    </p>
    <p data-testid="trade-result" class="text-sm font-bold">
      {tied ? "Tied" : <>
        <OwnerLink owner={first.owner} /> won by <span class="tabular-nums">{formatPoints(trade.margin)}</span>
      </>}
    </p>
  </header>
  <div class="mt-4 grid gap-3 md:grid-cols-2">
    {trade.sides.map((side) => (
      <section
        data-testid="trade-side"
        data-outcome={side.outcome}
        class:list={["min-w-0 rounded-2xl border p-3", side.outcome === "won" ? "border-brand bg-brand/10" : "border-line"]}
      >
        <div class="flex items-baseline justify-between gap-3">
          <div class="min-w-0">
            <h4 class="font-bold"><OwnerLink owner={side.owner} /></h4>
            <p class="truncate text-xs text-muted">{side.teamName} received</p>
          </div>
          <p class="shrink-0 text-right">
            <span data-testid="side-total" class="block text-xl font-black tabular-nums">{formatSigned(side.total)}</span>
            <span data-testid="side-raw" class="block text-[0.7rem] text-muted tabular-nums">{formatPoints(side.rawTotal)} raw</span>
            <span class="text-[0.7rem] uppercase tracking-wider text-muted">{side.outcome}</span>
          </p>
        </div>
        <ul class="mt-3 divide-y divide-line text-sm">
          {side.players.map((p) => (
            <li data-testid="traded-player" class="flex items-baseline justify-between gap-3 py-1.5">
              <span class="min-w-0">
                <span class="font-medium">{p.name}</span>
                <span class="ml-1.5 whitespace-nowrap text-xs text-muted">{p.position}{p.nflTeam && ` · ${p.nflTeam}`}</span>
              </span>
              <span class="shrink-0 text-right tabular-nums">
                <span data-testid="player-value" class="font-semibold">{formatSigned(p.value)}</span>
                <span class="block text-[0.7rem] text-muted">{formatPoints(p.points)} raw · {p.weeksStarted} {p.weeksStarted === 1 ? "start" : "starts"}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</article>

<style>
  /* The shine: a soft gold band that sweeps across once on hover. Hidden on phones and under reduced motion. */
  .fleeced-shine { display: none; }
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .fleeced-shine {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(110deg, transparent 35%, color-mix(in srgb, var(--color-gold) 22%, transparent) 50%, transparent 65%);
      background-size: 250% 100%;
      background-position: 150% 0;
    }
    .fleeced:hover .fleeced-shine { animation: fleeced-shine 2.4s ease-in-out; }
  }
  @keyframes fleeced-shine {
    from { background-position: 150% 0; }
    to { background-position: -50% 0; }
  }
</style>
