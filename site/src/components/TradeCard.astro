---
// One trade as a card (#62): Season and Week, both sides with the Players each received (position, NFL
// team, starter points, Weeks started) and the side total, "won by N", and the winning side highlighted.
// Reused later by the Season and Owner Transactions tabs, which filter transactions.json.
import type { Trade } from "../data/site-data";
import { formatPoints } from "../data/site-data";
import OwnerLink from "./OwnerLink.astro";

interface Props { trade: Trade }
const { trade } = Astro.props;
const [first] = trade.sides;
const tied = first.outcome === "tied";
---
<article data-testid="trade-card" data-year={trade.year} data-week={trade.week} class="rounded-3xl border border-line bg-panel/40 p-4 md:p-5">
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted">
      <a href={`/seasons/${trade.year}/`} class="transition-colors hover:text-brand">{trade.year}</a> · Week {trade.week}
    </p>
    <p data-testid="trade-result" class="text-sm font-bold">
      {tied ? "Tied" : <>
        <OwnerLink owner={first.owner} /> won by <span class="tabular-nums">{formatPoints(trade.margin)}</span>
      </>}
    </p>
  </header>
  <div class="mt-4 grid gap-3 md:grid-cols-2">
    {trade.sides.map((side) => (
      <section
        data-testid="trade-side"
        data-outcome={side.outcome}
        class:list={["min-w-0 rounded-2xl border p-3", side.outcome === "won" ? "border-brand bg-brand/10" : "border-line"]}
      >
        <div class="flex items-baseline justify-between gap-3">
          <div class="min-w-0">
            <h4 class="font-bold"><OwnerLink owner={side.owner} /></h4>
            <p class="truncate text-xs text-muted">{side.teamName} received</p>
          </div>
          <p class="shrink-0 text-right">
            <span data-testid="side-total" class="block text-xl font-black tabular-nums">{formatPoints(side.total)}</span>
            <span class="text-[0.7rem] uppercase tracking-wider text-muted">{side.outcome}</span>
          </p>
        </div>
        <ul class="mt-3 divide-y divide-line text-sm">
          {side.players.map((p) => (
            <li data-testid="traded-player" class="flex items-baseline justify-between gap-3 py-1.5">
              <span class="min-w-0">
                <span class="font-medium">{p.name}</span>
                <span class="ml-1.5 whitespace-nowrap text-xs text-muted">{p.position}{p.nflTeam && ` · ${p.nflTeam}`}</span>
              </span>
              <span class="shrink-0 text-right tabular-nums">
                {formatPoints(p.points)}
                <span class="block text-[0.7rem] text-muted">{p.weeksStarted} {p.weeksStarted === 1 ? "start" : "starts"}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</article>
