---
// One Hall of Fame Inductee as a card front (#73): the Player, position and NFL team, the Season (linked)
// with its Scoring format badge, the credited Owner (linked) and team name, a badge and value per lane
// cleared, then Season points and Positional finish. A plain gold border: gold is allowed because an
// Inductee is a trophy item (docs/GAMEPLAN.md). The flip, tilt and shine come in #77.
// Reused by the Season and Owner pages, which filter hall-of-fame.json (#75, #76).
import type { Inductee } from "../data/site-data";
import { formatPoints } from "../data/site-data";
import OwnerLink from "./OwnerLink.astro";

interface Props { inductee: Inductee }
const { inductee: i } = Astro.props;
const LANES = { dominant: { label: "Dominant", measure: "above replacement" } } as const;
---
<article
  data-testid="inductee-card"
  data-year={i.year}
  class="flex min-w-0 flex-col rounded-3xl border-2 border-gold bg-panel/40 p-4 md:p-5"
>
  <header class="flex flex-wrap items-center justify-between gap-2">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">
      <a href={`/seasons/${i.year}/`} class="transition-colors hover:text-brand">{i.year}</a>
    </p>
    <span data-testid="format-badge" class="whitespace-nowrap rounded-full border border-line px-2 py-0.5 text-[0.7rem] text-muted">{i.scoringFormat}</span>
  </header>
  <h3 data-testid="inductee-name" class="mt-3 text-2xl font-black leading-tight">{i.name}</h3>
  <p data-testid="inductee-position" class="text-sm text-muted">{i.position}{i.nflTeam && ` · ${i.nflTeam}`}</p>
  <p class="mt-3 text-sm">
    <span class="font-bold"><OwnerLink owner={i.owner} /></span>
    <span class="block truncate text-xs text-muted">{i.teamName}</span>
  </p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {i.lanes.map((lane) => (
      <li data-testid="inductee-lane" data-lane={lane.lane} class="rounded-2xl border border-gold/60 bg-gold/10 px-3 py-1.5">
        <span class="block text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold">{LANES[lane.lane].label}</span>
        <span data-testid="lane-value" class="text-sm font-bold tabular-nums">+{formatPoints(lane.value)}</span>
        <span class="text-xs text-muted"> {LANES[lane.lane].measure}</span>
      </li>
    ))}
  </ul>
  <dl class="mt-auto grid grid-cols-2 gap-3 pt-4 text-sm">
    <div>
      <dt class="text-[0.7rem] uppercase tracking-wider text-muted">Season points</dt>
      <dd data-testid="inductee-points" class="font-semibold tabular-nums">{formatPoints(i.points)}</dd>
    </div>
    <div>
      <dt class="text-[0.7rem] uppercase tracking-wider text-muted">Finish</dt>
      <dd data-testid="inductee-finish" class="font-semibold">{i.position}{i.positionalFinish}</dd>
    </div>
  </dl>
</article>
